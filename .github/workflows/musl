        echo "TOOLCHAIN=$(pwd)/armv7l-linux-musleabihf-cross/bin/armv7l-linux-musleabihf-gcc" >> $GITHUB_ENV
        echo "✅ armv7l toolchain ready"

    - name: Build static binary for armv7l
      run: |
        echo "=== Building AppOpt-armv7l ==="
        ${{ env.TOOLCHAIN }} \
            -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-armv7l \
            AppOpts.c
        
        file AppOpt-armv7l
        strip AppOpt-armv7l
        ls -lh AppOpt-armv7l

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-armv7l
        path: AppOpt-armv7l
        retention-days: 90
        compression-level: 0

