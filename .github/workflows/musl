name: Build AppOpts

on:
  push:
    branches: [ main, master ]
    paths:
      - 'AppOpts.c'
      - 'uthash.h'
  pull_request:
    branches: [ main, master ]
  release:
    types: [ created ]
  workflow_dispatch:

jobs:
  # ==================== Linux x86_64 ====================
  build-x86_64:
    name: Build for x86_64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        if [ ! -f uthash.h ]; then
          wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h
        fi
        echo "✅ uthash.h ready"
        ls -la uthash.h

    - name: Verify source file
      run: |
        if [ ! -f AppOpts.c ]; then
          echo "❌ AppOpts.c not found!"
          exit 1
        fi
        echo "✅ Found AppOpts.c"
        head -5 AppOpts.c

    - name: Install musl-tools
      run: |
        sudo apt update
        sudo apt install -y musl-tools

    - name: Build static binary for x86_64
      run: |
        echo "=== Building AppOpt-x86_64 ==="
        musl-gcc -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-x86_64 \
            AppOpts.c
        
        # 验证静态编译
        file AppOpt-x86_64
        if file AppOpt-x86_64 | grep -q "statically linked"; then
          echo "✅ Fully static binary verified"
        else
          echo "⚠️ Binary may have dynamic dependencies"
          ldd AppOpt-x86_64 2>&1 || true
        fi
        
        # 去除调试符号
        strip AppOpt-x86_64
        echo "=== Final size ==="
        ls -lh AppOpt-x86_64

    - name: Test binary
      run: |
        chmod +x AppOpt-x86_64
        ./AppOpt-x86_64 -v || echo "Version check OK (no config file)"

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-x86_64
        path: AppOpt-x86_64
        retention-days: 90
        compression-level: 0

  # ==================== Linux aarch64 ====================
  build-aarch64:
    name: Build for aarch64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h
        ls -la uthash.h

    - name: Download musl cross toolchain for aarch64
      run: |
        wget -q https://musl.cc/aarch64-linux-musl-cross.tgz
        tar -xzf aarch64-linux-musl-cross.tgz
        echo "TOOLCHAIN=$(pwd)/aarch64-linux-musl-cross/bin/aarch64-linux-musl-gcc" >> $GITHUB_ENV
        echo "✅ aarch64 toolchain ready"

    - name: Build static binary for aarch64
      run: |
        echo "=== Building AppOpt-aarch64 ==="
        ${{ env.TOOLCHAIN }} \
            -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-aarch64 \
            AppOpts.c
        
        file AppOpt-aarch64
        strip AppOpt-aarch64
        ls -lh AppOpt-aarch64

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-aarch64
        path: AppOpt-aarch64
        retention-days: 90
        compression-level: 0

