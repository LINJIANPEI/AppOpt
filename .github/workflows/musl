        ls -lh AppOpt-freebsd-x86_64

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-freebsd-x86_64
        path: AppOpt-freebsd-x86_64
        retention-days: 90

  # ==================== 使用 Zig 统一编译多个架构（备选方案） ====================
  zig-multi-build:
    name: Zig multi-arch build
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - target: x86_64-linux-musl
            output: AppOpt-x86_64-musl
          - target: aarch64-linux-musl
            output: AppOpt-aarch64-musl
          - target: armv7-linux-musleabihf
            output: AppOpt-armv7l-musl
          - target: i686-linux-musl
            output: AppOpt-i686-musl
          - target: riscv64-linux-musl
            output: AppOpt-riscv64-musl
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Zig
      uses: mlugg/setup-zig@v1
      with:
        version: 0.12.0

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h

    - name: Build with Zig for ${{ matrix.target }}
      run: |
        echo "=== Building ${{ matrix.output }} ==="
        zig cc -target ${{ matrix.target }} \
            -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o ${{ matrix.output }} \
            AppOpts.c
        
        file ${{ matrix.output }} || true
        strip ${{ matrix.output }} 2>/dev/null || true
        ls -lh ${{ matrix.output }}

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: ${{ matrix.output }}
        path: ${{ matrix.output }}
        retention-days: 90
        if-no-files-found: warn

  # ==================== 发布阶段 ====================
  release:
    name: Create Release Package
    if: github.event_name == 'release'
    runs-on: ubuntu-latest
    needs: [build-x86_64, build-aarch64, build-armv7l, build-i686, build-riscv64, build-macos-x86_64, build-macos-aarch64, build-windows-x86_64, build-freebsd-x86_64]
    
    steps:
    - name: Download all artifacts
      uses: actions/download-artifact@v4
      with:
        path: artifacts/

    - name: List all artifacts
      run: |
        echo "=== All downloaded artifacts ==="
        find artifacts/ -type f | sort

    - name: Organize release files
      run: |
        mkdir -p release/
        
        # 收集所有二进制文件
        find artifacts/ -type f \( -name "AppOpt-*" -o -name "*.exe" \) | while read file; do
          filename=$(basename "$file")
          cp "$file" "release/$filename"
          echo "Added: $filename"
        done
        
        # 添加配置文件示例
        cat > release/applist.conf.example << 'EOF'
        # AppOpt 配置文件
        # 格式: 进程名{线程名}=CPU核心
        
        # 示例规则
        nginx=0-3
        nginx{worker}=0-3
        mysql=4-7
        mysql{*io*}=4-7
        chrome*=8-11
        java*{*GC*}=12-15
        
        # CPU范围格式: 0,2,4 或 0-3 或 0-3,8,10-12
        # 通配符: * ? [0-9]
        EOF
        
        # 添加 README
        cat > release/README.md << 'EOF'
        # AppOpt - CPU Affinity Optimizer
        
        ## 简介
        AppOpt 是一个 Linux 进程/线程 CPU 亲和性自动优化工具，可根据配置文件自动将指定应用的线程绑定到特定 CPU 核心。
        
        ## 特性
        - ✅ 完全静态链接，无需运行时依赖
        - ✅ 支持多架构 (x86_64, aarch64, armv7l, i686, riscv64)
        - ✅ 支持配置文件热更新 (inotify)
        - ✅ 支持进程名和线程名通配符匹配
        - ✅ 规则优先级自动计算
        
        ## 使用方法
        
        ### Linux
        ```bash
        # 赋予执行权限
        chmod +x AppOpt-x86_64
        
        # 运行 (需要 root 权限)
        sudo ./AppOpt-x86_64 -c /path/to/applist.conf -s 2
        
        # 查看帮助
        ./AppOpt-x86_64 -h
        
        # 查看版本
        ./AppOpt-x86_64 -v
