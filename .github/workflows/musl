        file AppOpt-i686
        strip AppOpt-i686
        ls -lh AppOpt-i686

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-i686
        path: AppOpt-i686
        retention-days: 90
        compression-level: 0

  # ==================== Linux riscv64 ====================
  build-riscv64:
    name: Build for riscv64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h

    - name: Download musl cross toolchain for riscv64
      run: |
        wget -q https://musl.cc/riscv64-linux-musl-cross.tgz
        tar -xzf riscv64-linux-musl-cross.tgz
        echo "TOOLCHAIN=$(pwd)/riscv64-linux-musl-cross/bin/riscv64-linux-musl-gcc" >> $GITHUB_ENV
        echo "✅ riscv64 toolchain ready"

    - name: Build static binary for riscv64
      run: |
        echo "=== Building AppOpt-riscv64 ==="
        ${{ env.TOOLCHAIN }} \
            -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-riscv64 \
            AppOpts.c
        
        file AppOpt-riscv64 || true
        strip AppOpt-riscv64 2>/dev/null || true
        ls -lh AppOpt-riscv64 2>/dev/null || echo "Build may have issues"

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-riscv64
        path: AppOpt-riscv64
        retention-days: 90
        if-no-files-found: warn

  # ==================== macOS x86_64 (cross compile) ====================
  build-macos-x86_64:
    name: Build for macOS x86_64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h

    - name: Setup Zig
      uses: mlugg/setup-zig@v1
      with:
        version: 0.12.0

    - name: Build for macOS x86_64
      run: |
        echo "=== Building AppOpt-macos-x86_64 ==="
        zig cc -target x86_64-macos \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-macos-x86_64 \
            AppOpts.c
        
        file AppOpt-macos-x86_64
        ls -lh AppOpt-macos-x86_64

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-macos-x86_64
        path: AppOpt-macos-x86_64
        retention-days: 90

  # ==================== macOS aarch64 (Apple Silicon) ====================
  build-macos-aarch64:
    name: Build for macOS aarch64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h

    - name: Setup Zig
      uses: mlugg/setup-zig@v1
      with:
        version: 0.12.0

    - name: Build for macOS aarch64
      run: |
        echo "=== Building AppOpt-macos-aarch64 ==="
        zig cc -target aarch64-macos \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
