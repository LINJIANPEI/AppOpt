        echo "TOOLCHAIN=$(pwd)/i686-linux-musl-cross/bin/i686-linux-musl-gcc" >> $GITHUB_ENV
        echo "✅ i686 toolchain ready"

    - name: Build static binary for i686
      run: |
        echo "=== Building AppOpt-i686 ==="
        ${{ env.TOOLCHAIN }} \
            -static \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-i686 \
