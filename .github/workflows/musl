    - name: Build for FreeBSD x86_64
      run: |
        echo "=== Building AppOpt-freebsd-x86_64 ==="
        zig cc -target x86_64-freebsd \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-freebsd-x86_64 \
            AppOpts.c
        
