      run: |
        echo "=== Building AppOpt-windows-x86_64.exe ==="
        zig cc -target x86_64-windows \
            -O2 \
            -pthread \
            -Wall -Wextra \
            -D_GNU_SOURCE \
            -o AppOpt-windows-x86_64.exe \
            AppOpts.c
        
        file AppOpt-windows-x86_64.exe || true
        ls -lh AppOpt-windows-x86_64.exe

    - name: Upload artifact
      uses: actions/upload-artifact@v4
      with:
        name: AppOpt-windows-x86_64
        path: AppOpt-windows-x86_64.exe
        retention-days: 90

  # ==================== FreeBSD x86_64 ====================
  build-freebsd-x86_64:
    name: Build for FreeBSD x86_64
    runs-on: ubuntu-latest
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download uthash.h
      run: |
        wget -q https://raw.githubusercontent.com/troydhanson/uthash/master/src/uthash.h

    - name: Setup Zig
      uses: mlugg/setup-zig@v1
      with:
